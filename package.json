{
  "name": "zennobserver",
  "version": "1.0.0",
  "description": "ふさもふを観測してZennにデプロイするリポジトリ",
  "private": true,
  "scripts": {
    "new:article": "zenn new:article",
    "new:book": "zenn new:book",
    "preview": "zenn preview",
    "validate": "node scripts/validate-articles.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run test:editorial && npm run validate",
    "test:editorial": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "editorial": "python3 scripts/editorial.py",
    "sphere:bootstrap": "python3 scripts/sphere-dos.py bootstrap",
    "sphere:boot": "python3 scripts/sphere-dos.py boot",
    "sphere:status": "python3 scripts/sphere-dos.py status"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saitoomituru/Zennobserver.git"
  },
  "keywords": [],
  "author": "ふさもふ / Mitsuru Saitō / ZeroRoomLab",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "bugs": {
    "url": "https://github.com/saitoomituru/Zennobserver/issues"
  },
  "homepage": "https://github.com/saitoomituru/Zennobserver#readme",
  "devDependencies": {
    "yaml": "2.9.1",
    "zenn-cli": "0.5.4",
    "zenn-model": "0.5.4"
  }
}
